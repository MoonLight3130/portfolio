# ============================================
# EmailJS Configuration for Contact Form
# ============================================
# Get these values from your EmailJS dashboard: https://dashboard.emailjs.com/
#
# 1. SERVICE_ID: Create an Email Service (Gmail, Outlook, etc.)
# 2. TEMPLATE_ID: Create an Email Template with these variables:
#    - {{from_name}} - sender's name
#    - {{from_email}} - sender's email
#    - {{subject}} - message subject
#    - {{message}} - message body
#    - {{to_email}} - your email (haransanthosh123@gmail.com)
# 3. PUBLIC_KEY: Your account public key
#
# Vercel Deployment:
# Add these as Environment Variables in Vercel Dashboard:
# Project Settings → Environment Variables → Add New
# ============================================

VITE_EMAILJS_SERVICE_ID=service_q3jxs87
VITE_EMAILJS_TEMPLATE_ID=template_6qidyxn
VITE_EMAILJS_PUBLIC_KEY=LxNCpXJTsPIOhCgD5
